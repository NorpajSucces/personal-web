# Copy this file to .env.local for local configuration.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Keep secrets server-only and never commit real values.
# Add variables only in the phase that introduces their integration.

DATABASE_URL=

# Supabase Auth: use the project's public publishable key, never a secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Immutable Supabase Auth user ID of the single authorized administrator.
# Keep this server-only; never prefix it with NEXT_PUBLIC_.
ADMIN_USER_ID=
