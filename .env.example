# Copy this file to .env.local for local configuration.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Keep secrets server-only and never commit real values.
# Add variables only in the phase that introduces their integration.

DATABASE_URL=

# Canonical production origin used for SEO, for example https://example.com.
# Public pages remain noindex until this is set to a valid HTTPS origin.
NEXT_PUBLIC_SITE_URL=

# Supabase Auth: use the project's public publishable key, never a secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key used for private Storage uploads and reads.
SUPABASE_SECRET_KEY=

# Immutable Supabase Auth user ID of the single authorized administrator.
# Keep this server-only; never prefix it with NEXT_PUBLIC_.
ADMIN_USER_ID=

# Contact form email delivery. Keep the API key server-only.
RESEND_API_KEY=
CONTACT_EMAIL=
CONTACT_FROM_EMAIL=
